# Copy this file to .env and edit as needed. Every value has a working
# default, so Conduit runs with none of this set.

# Root directory the file tools are sandboxed to. Created automatically.
CONDUIT_WORKSPACE=./workspace

# Optional: raises the GitHub API rate limit from 60/hour to 5,000/hour.
# Create a token with no scopes at https://github.com/settings/tokens
GITHUB_TOKEN=

# Only used for --transport http
CONDUIT_HOST=127.0.0.1
CONDUIT_PORT=8000

# Auth is entirely opt-in for the HTTP transport: leave CONDUIT_AUTH_ISSUER
# unset and /mcp stays unauthenticated, exactly as before this was added.
# Conduit acts as an OAuth 2.1 Resource Server only — it verifies bearer
# tokens issued by the Authorization Server below, it never issues them.
#
# CONDUIT_AUTH_ISSUER=https://your-tenant.us.auth0.com/
# CONDUIT_AUTH_JWKS_URL=                # defaults to <issuer>/.well-known/jwks.json
# CONDUIT_AUTH_AUDIENCE=                # defaults to http://<host>:<port>/mcp — set this explicitly for any real deployment
# CONDUIT_AUTH_REQUIRED_SCOPES=         # space-separated, e.g. "conduit:read conduit:write"