# Copy this file to .env and edit as needed. Never commit real secrets.

# Root directory the file tools are sandboxed to. Created automatically.
CONDUIT_WORKSPACE=./workspace

# Optional: raises the GitHub API rate limit from 60/hour to 5,000/hour.
# Create a token with no scopes at https://github.com/settings/tokens
GITHUB_TOKEN=

# Only used for --transport http
CONDUIT_HOST=127.0.0.1
CONDUIT_PORT=8000

# Conduit resource-server authentication (Auth0 issues bearer tokens).
CONDUIT_AUTH_ISSUER=https://dev-jf6pbb4exdzatprm.eu.auth0.com/
CONDUIT_AUTH_JWKS_URL=https://dev-jf6pbb4exdzatprm.eu.auth0.com/.well-known/jwks.json
CONDUIT_AUTH_AUDIENCE=https://conduit-mcp.onrender.com/mcp
CONDUIT_AUTH_REQUIRED_SCOPES=conduit:read

# Server-side Auth0 Management API integration.
# These credentials stay on the Conduit server and are never returned to MCP callers.
AUTH0_DOMAIN=dev-jf6pbb4exdzatprm.eu.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=https://dev-jf6pbb4exdzatprm.eu.auth0.com/api/v2/
